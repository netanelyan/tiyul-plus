# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local Claude Code session state (permissions, worktrees) - machine-specific
/.claude/

# typescript
*.tsbuildinfo
next-env.d.ts

# Photo verification cache (scripts/verify-photos.mjs)
.cache/
photo-report.json

# catalog regeneration output (review artifacts, not committed)
src/data/*.generated.ts
.schemaorg.jsonld

# Internal planning and operations notes. This repository is public, so these
# were readable by anyone: the business brief and pricing rationale (CLAUDE.md),
# what is being built next (TODO.md), the go-live steps including which revenue
# levers are not switched on yet (LAUNCH-CHECKLIST.md), and how the service is
# operated and recovered (RUNBOOK.md). They stay on disk - CLAUDE.md in
# particular is still the brief every session reads - they are simply no longer
# published.
#
# Untracking only stops future commits. Every version already pushed remains in
# the history and is still readable on GitHub; closing that needs either a
# history rewrite or a private repository.
CLAUDE.md
TODO.md
LAUNCH-CHECKLIST.md
RUNBOOK.md

# Database dumps from scripts/backup-supabase.mjs.
# These hold real travellers' trips, names, phone numbers and email addresses.
# Committing one would publish, to a git history nobody can rewrite, exactly the
# data the backup exists to protect. Keep them off the machine's repo entirely.
/backups/
tiyul-backup-*.json
