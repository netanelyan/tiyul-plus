# The email templates are GENERATED by scripts/build-emails.mjs, which writes
# LF, and the drift guard in mail.test.ts compares the files on disk against the
# generated module byte for byte. With git's default autocrlf on Windows the
# checkout rewrites them to CRLF, so the guard fails on every Windows clone -
# not because a template drifted, but because git edited it on the way out.
# Pinning them to LF is what makes "these two are the same templates" a claim
# about content again.
emails/*.html   text eol=lf
emails/subjects.json text eol=lf

# The OG-card fonts. Git's binary detection normally gets this right, but a
# font silently rewritten by autocrlf does not fail loudly - it renders as
# tofu on a share card nobody on the team looks at twice.
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
